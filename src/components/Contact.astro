---
import type { SiteContent } from "@data/content";
type Props = { content: SiteContent };
const { content } = Astro.props;
const { identity } = content;
const copy = content.ui.contact;
---
<section id="contacto" class="section contact-section">
  <div class="container contact-grid">
    <div>
      <p class="small-label">{copy.eyebrow}</p>
      <h2>{copy.headlineFirst}<br /><span>{copy.headlineSecond}</span></h2>
      <p>{copy.description}</p>
    </div>
    <div class="contact-actions">
      <a class="email-link" href={`mailto:${identity.email}`}>{identity.email} <span aria-hidden="true">↗</span></a>
      <div class="social-links"><a href={identity.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={identity.githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
</section>
<style>
  .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:center; }
  .contact-section .small-label { margin:0 0 1.5rem; }
  h2 { font-size:clamp(2.5rem,4.5vw,4rem); line-height:1.15; letter-spacing:-.06em; font-weight:500; margin:0 0 1.5rem; }
  h2 span { color:var(--accent); }
  .contact-grid p:not(.small-label) { font-size:1rem; color:var(--text-smoke); line-height:1.7; max-width:40ch; margin:0; }
  .email-link { display:flex; align-items:center; justify-content:space-between; gap:1rem; color:var(--text); text-decoration:none; border-bottom:1px solid var(--line); padding:1rem 0; font-size:clamp(.95rem,1.5vw,1.25rem); overflow-wrap:anywhere; }
  .email-link:hover { color:var(--accent); }
  .social-links { display:flex; gap:1.5rem; margin-top:1.5rem; }
  .social-links a { color:var(--text-smoke); font-size:.95rem; text-decoration:none; padding:.5rem 0; }
  .social-links a:hover { color:var(--accent); }
  @media(max-width:700px) { .contact-grid { grid-template-columns:1fr; gap:1.8rem; } }
</style>
