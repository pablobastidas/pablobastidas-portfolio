---
import type { SiteContent } from "@data/content";
type Props = { content: SiteContent };
const { content } = Astro.props;
const { nav } = content.ui;
---
<header class="site-header">
  <nav class="container navigation" aria-label={nav.label}>
    <a class="wordmark" href="#inicio">{content.identity.name}<span>.</span></a>
    <div class="navigation-links">
      <a href="#proyectos">{nav.projects}</a>
      <a href="#trayectoria">{nav.about}</a>
      <a class="linkedin" href={content.identity.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="language-link" href={content.lang === "es" ? "/en" : "/"} aria-label={nav.languageAria}>{nav.languageLabel}</a>
      <a class="header-contact" href="#contacto">{nav.contact} <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .site-header {
    position:sticky;
    top:0;
    z-index:50;
    padding:1rem 0;
    background:color-mix(in srgb,var(--bg) 94%,transparent);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid transparent;
    transition:border-color .2s ease,box-shadow .2s ease;
  }
  .site-header.is-scrolled { border-bottom-color:var(--line); box-shadow:0 5px 18px rgb(23 35 59 / 5%); }
  .navigation { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; }
  .wordmark { color:var(--text); font-family:var(--font-display); font-size:1rem; font-weight:600; letter-spacing:-.055em; text-decoration:none; white-space:nowrap; }
  .wordmark span { color:var(--accent); }
  .navigation-links { display:flex; align-items:center; gap:1.8rem; }
  .navigation-links a { color:var(--text-smoke); font-size:.95rem; text-decoration:none; min-height:44px; display:inline-flex; align-items:center; }
  .navigation-links a:hover { color:var(--text); }
  .navigation-links .language-link { font-size:.8rem; }
  .navigation-links .header-contact { min-height:44px; color:var(--accent); border:1px solid var(--line); border-radius:.35rem; padding:.45rem 1rem; gap:.8rem; font-weight:600; }
  .navigation-links a[aria-current="location"] { color:var(--accent); }
  .navigation-links a[aria-current="location"]::after { content:""; position:absolute; height:2px; background:var(--accent); inset:auto 0 .2rem; }
  .navigation-links a[href^="#"] { position:relative; }
  @media(max-width:600px) { .site-header { padding:.75rem 0; } .navigation { flex-wrap:wrap; gap:.35rem; } .navigation-links { width:100%; justify-content:space-between; gap:.6rem; } .navigation-links a { font-size:.75rem; } .navigation-links .linkedin { display:none; } .navigation-links .header-contact { padding:.35rem .75rem; } }
</style>
<script>
  const header = document.querySelector('.site-header');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.navigation-links a[href^="#"]'));

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateCurrentSection, { passive: true });

  document.querySelector('.language-link')?.addEventListener('click', () => {
    localStorage.setItem('preferred-lang', document.documentElement.lang === 'es' ? 'en' : 'es');
  });

  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!))
    .filter((section): section is HTMLElement => section !== null);

  const setCurrentLink = (id: string) => links.forEach((link) => {
    if (link.getAttribute('href') === `#${id}`) link.setAttribute('aria-current', 'location');
    else link.removeAttribute('aria-current');
  });

  function updateCurrentSection() {
    const pageHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
    const atPageEnd = window.scrollY + window.innerHeight >= pageHeight - 2;
    const current = atPageEnd
      ? sections.at(-1)
      : [...sections].reverse().find((section) => section.getBoundingClientRect().top <= window.innerHeight * 0.65);
    if (current) setCurrentLink(current.id);
    else links.forEach((link) => link.removeAttribute('aria-current'));
  }

  links.forEach((link) => link.addEventListener('click', () => {
    const id = link.getAttribute('href')?.slice(1);
    if (id) setCurrentLink(id);
  }));
  updateCurrentSection();
  window.addEventListener('scroll', updateCurrentSection, { passive: true });
</script>
