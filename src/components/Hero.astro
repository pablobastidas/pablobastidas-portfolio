---
import type { SiteContent } from "@data/content";
type Props = { content: SiteContent };
const { content } = Astro.props;
const { hero } = content.ui;
---
<section id="inicio" class="hero">
  <div class="container">
    <div class="hero-intro">
      <p>{hero.intro}</p>
      <span>{content.identity.location}</span>
    </div>
    <h1>{hero.headlineFirst}<br /><span>{hero.headlineSecond}</span></h1>
    <div class="hero-bottom">
      <p>{hero.summary}</p>
      <div class="hero-actions">
        <a class="button-primary" href="#proyectos">{hero.projectsAction} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={`mailto:${content.identity.email}`}>{hero.contactAction} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { padding:4.5rem 0 4rem; }
  .hero-intro { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; margin-bottom:2.1rem; color:var(--text-smoke); font-size:.85rem; }
  .hero-intro p { margin:0; }
  .hero-intro span { font-size:.8rem; white-space:nowrap; }
  h1 { font-size:clamp(2.6rem,6.1vw,5.25rem); line-height:1.15; letter-spacing:-.065em; font-weight:500; margin:0; }
  h1 span { color:var(--accent); }
  .hero-bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:3rem; margin-top:2.5rem; }
  .hero-bottom > p { color:var(--text-smoke); font-size:1.1rem; line-height:1.7; max-width:53ch; margin:0; }
  .hero-actions { display:flex; align-items:center; flex-shrink:0; gap:1.5rem; }
  .hero-actions .text-link { white-space:nowrap; }
  @media(max-width:900px) { .hero-bottom { align-items:flex-start; flex-direction:column; gap:1.5rem; } }
  @media(max-width:600px) {
    .hero { padding:2.5rem 0 3rem; }
    .hero-intro { flex-direction:column; align-items:flex-start; gap:.4rem; margin-bottom:1.8rem; }
    h1 { font-size:clamp(2.15rem,7.4vw,3rem); letter-spacing:-.06em; }
    .hero-bottom { margin-top:1.8rem; }
    .hero-bottom > p { font-size:1.02rem; }
    .hero-actions { flex-wrap:wrap; gap:1rem 1.5rem; }
  }
</style>
