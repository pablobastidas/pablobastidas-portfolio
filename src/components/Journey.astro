---
import type { SiteContent } from "@data/content";
import Strengths from "./Strengths.astro";
type Props = { content: SiteContent };
const { content } = Astro.props;
const copy = content.ui.journey;
---
<section class="section about-section" id="trayectoria">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <p class="small-label">{copy.eyebrow}</p>
        <h2>{copy.headlineFirst}<br />{copy.headlineSecond}</h2>
        <p>{copy.description}</p>
        <a class="text-link" href={content.identity.linkedinUrl} target="_blank" rel="noopener noreferrer">{copy.linkedinAction} <span aria-hidden="true">↗</span></a>
      </div>
      <Strengths content={content} />
    </div>
    <details>
      <summary>{copy.experienceAction}</summary>
      <div class="experience-list">{content.experience.map(exp => <article><span class="small-label">{exp.year}</span><div><h3>{exp.title}</h3><p class="company">{exp.company}</p><p>{exp.description}</p></div></article>)}</div>
    </details>
  </div>
</section>
<style>
  .about-section { background:var(--surface); }
  .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:5rem; }
  .about-content > .small-label { margin:0 0 1.5rem; }
  h2 { font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.3; letter-spacing:-.055em; font-weight:500; margin:0 0 1.5rem; }
  .about-content > p:not(.small-label) { color:var(--text-smoke); font-size:1rem; line-height:1.75; margin:0 0 1rem; max-width:49ch; }
  details { margin-top:3rem; border-top:1px solid var(--line); }
  summary { font-size:.95rem; cursor:pointer; padding:1.2rem 0; }
  .experience-list article { display:grid; grid-template-columns:9rem 1fr; gap:2rem; border-top:1px solid var(--line); padding:1.5rem 0; }
  .experience-list h3 { font-size:1rem; font-weight:500; line-height:1.5; letter-spacing:-.025em; margin:0; }
  .experience-list p { color:var(--text-smoke); font-size:.95rem; line-height:1.7; margin:.7rem 0 0; }
  .experience-list .company { font-size:.85rem; }
  @media(max-width:800px) { .about-grid { grid-template-columns:1fr; gap:2.5rem; } }
  @media(max-width:500px) { .experience-list article { grid-template-columns:1fr; gap:.7rem; } }
</style>
