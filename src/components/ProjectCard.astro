---
import type { SiteContent } from "@data/content";
type Props = { project: SiteContent["projects"][number]; content: SiteContent; featured?: boolean };
const { project, content, featured = false } = Astro.props;
const copy = content.ui.projects;
---
<article class:list={["project", { featured }]}>
  {featured && <a class="project-image" href={project.links[0]?.href} target="_blank" rel="noopener noreferrer" aria-label={`${copy.visitImageLabel} ${project.name}`}>
    <img src={`/images/projects/${project.slug}.jpg`} alt={`${copy.imageAlt} ${project.name}`} width="1280" height="850" loading="lazy" decoding="async" />
  </a>}
  <div class="project-copy">
    <p class="small-label">{featured ? copy.featuredLabel : project.role}</p>
    <h3>{project.name}</h3>
    <p class="project-description">{project.cardDescription}</p>
    <p class="project-tech">{project.tech.slice(0,featured ? 4 : 3).join(" / ")}</p>
    <a class="text-link" href={project.links[0]?.href} target="_blank" rel="noopener noreferrer">{copy.visitAction} <span aria-hidden="true">↗</span><span class="sr-only"> — {project.name} ({copy.newTabHint})</span></a>
  </div>
</article>
<style>
  .project { min-width:0; }
  .featured { display:grid; grid-template-columns:1.5fr 1fr; align-items:center; gap:3rem; }
  .project-image { display:block; border-radius:.5rem; overflow:hidden; }
  .project-image img { display:block; width:100%; height:auto; aspect-ratio:1.5; object-fit:cover; object-position:left top; }
  .small-label { margin:0 0 .9rem; line-height:1.6; }
  h3 { font-size:1.35rem; letter-spacing:-.045em; line-height:1.3; font-weight:500; margin:0 0 .9rem; }
  .featured h3 { font-size:clamp(1.9rem,3vw,2.6rem); }
  .project-description { color:var(--text-smoke); font-size:1rem; line-height:1.75; margin:0 0 1.2rem; max-width:53ch; }
  .project-tech { font-size:.8rem; color:var(--text-smoke); line-height:1.7; margin:0 0 1rem; }
  @media(max-width:800px) { .featured { grid-template-columns:1fr; gap:1.75rem; } }
</style>
