---
import ProjectCard from "./ProjectCard.astro";
import type { SiteContent } from "@data/content";
type Props = { content: SiteContent };
const { content } = Astro.props;
const selected = content.projects.filter(project => project.featured);
const featured = selected.find(project => project.slug === "kawin-event-platform");
const others = selected.filter(project => project.slug !== "kawin-event-platform");
const copy = content.ui.projects;
---
<section class="section projects-section" id="proyectos">
  <div class="container">
    <div class="projects-heading">
      <h2>{copy.heading}</h2>
      <p>{copy.description}</p>
    </div>
    {featured && <ProjectCard project={featured} content={content} featured />}
    <div class="other-projects">
      <p class="small-label">{copy.otherHeading}</p>
      <div class="secondary-grid">{others.map(project => <ProjectCard project={project} content={content} />)}</div>
    </div>
  </div>
</section>
<style>
  .projects-section { background:white; border-top:1px solid var(--line); }
  .projects-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:3rem; margin-bottom:2.5rem; }
  h2 { font-size:clamp(1.8rem,3vw,2.5rem); font-weight:500; letter-spacing:-.055em; margin:0; line-height:1.2; }
  .projects-heading > p { max-width:36ch; font-size:1rem; color:var(--text-smoke); line-height:1.6; margin:0; }
  .other-projects { margin-top:3rem; padding-top:2rem; border-top:1px solid var(--line); }
  .other-projects > p { margin:0 0 1.5rem; }
  .secondary-grid { display:grid; grid-template-columns:1fr 1fr; gap:4rem; }
  @media(max-width:700px) {
    .projects-heading { align-items:flex-start; flex-direction:column; gap:1rem; }
    .projects-heading > p { max-width:45ch; }
    .secondary-grid { grid-template-columns:1fr; gap:2rem; }
  }
</style>
