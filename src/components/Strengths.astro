---
import type { SiteContent } from "@data/content";
type Props = { content: SiteContent };
const { content } = Astro.props;
---
<div id="fortalezas" class="expertise">
  <p class="small-label">{content.ui.strengths.heading}</p>
  <dl>{content.ui.strengths.areas.map(area => <div><dt>{area.title}</dt><dd>{area.description}</dd></div>)}</dl>
</div>
<style>
  .expertise > p { margin:0 0 1.5rem; }
  dl { margin:0; }
  dl > div { display:grid; grid-template-columns:8rem 1fr; gap:1rem; padding:1.2rem 0; border-top:1px solid var(--line); }
  dt { font-size:1rem; font-weight:600; }
  dd { margin:0; color:var(--text-smoke); font-size:.95rem; line-height:1.6; }
  @media(max-width:400px) { dl > div { grid-template-columns:1fr; gap:.35rem; } }
</style>
