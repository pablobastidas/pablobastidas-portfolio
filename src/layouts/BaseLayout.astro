---
import "@styles/global.css";
import type { SiteContent } from "@data/content";

type Props = {
  title: string;
  description: string;
  content: SiteContent;
  lang?: "es" | "en";
};

const { title, description, content, lang = "es" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": content.identity.name,
  "jobTitle": content.profile.role,
  "url": Astro.site,
  "sameAs": [
    content.identity.githubUrl,
    content.identity.linkedinUrl
  ].filter(Boolean),
  "hasOccupation": content.experience.map(exp => ({
    "@type": "Occupation",
    "name": exp.title,
    "description": exp.description
  }))
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbff" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/og-image.svg" />

    <title>{title}</title>

    <script type="application/ld+json" is:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add("js-enabled");

      // i18n Auto-Detection & Redirection
      const storedLang = localStorage.getItem("preferred-lang");
      const browserLang = (navigator.language || "").toLowerCase();
      const currentPath = window.location.pathname;

      if (!storedLang) {
        if (browserLang.startsWith("en") && !currentPath.includes("/en")) {
          localStorage.setItem("preferred-lang", "en");
          window.location.href = "/en";
        } else if (!browserLang.startsWith("en") && currentPath.includes("/en")) {
          localStorage.setItem("preferred-lang", "es");
          window.location.href = "/";
        } else {
          localStorage.setItem("preferred-lang", currentPath.includes("/en") ? "en" : "es");
        }
      } else {
        if (storedLang === "en" && !currentPath.includes("/en")) {
          window.location.href = "/en";
        } else if (storedLang === "es" && currentPath.includes("/en")) {
          window.location.href = "/";
        }
      }
      
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{content.ui.skipToContent}</a>
    <slot />
  </body>
</html>

