---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import ProjectsSection from "@components/ProjectsSection.astro";
import Strengths from "@components/Strengths.astro";
import Journey from "@components/Journey.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { siteData } from "@data/site";

const lang = "en";
const t = siteData.translations[lang];
---

<BaseLayout title={t.seo.title} description={t.seo.description} lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero
      name={siteData.name}
      role={t.role}
      heroTagline={t.heroTagline}
      heroSummary={t.heroSummary}
      githubUrl={siteData.githubUrl}
      email={siteData.email}
      lang={lang}
    />
    <ProjectsSection lang={lang} />
    <Strengths lang={lang} />
    <Journey lang={lang} />
    <Contact email={siteData.email} githubUrl={siteData.githubUrl} linkedinUrl={siteData.linkedinUrl} lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
