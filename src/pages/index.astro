---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import ProjectsSection from "@components/ProjectsSection.astro";
import Journey from "@components/Journey.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { loadSiteContent } from "@data/content";

const lang = "es";
const content = await loadSiteContent(lang);
---

<BaseLayout title={content.seo.title} description={content.seo.description} content={content} lang={lang}>
  <Header content={content} />
  <main id="contenido">
    <Hero content={content} />
    <ProjectsSection content={content} />
    <Journey content={content} />
    <Contact content={content} />
  </main>
  <Footer content={content} />
</BaseLayout>

